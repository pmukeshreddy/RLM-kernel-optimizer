# Copy this to .env and fill in your values
# Never commit .env to git

# Required: Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Required for Pinecone-backed RAG
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=cuda-kernels
PINECONE_INDEX_HOST=your-full-index-host.pinecone.io
PINECONE_EMBED_PROVIDER=sentence-transformers
PINECONE_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
PINECONE_RERANK_MODEL=

# Optional Pinecone namespace
PINECONE_NAMESPACE=__default__

# Optional: CUDA toolkit path
# CUDA_HOME=/usr/local/cuda
